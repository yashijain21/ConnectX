# Copy to .env.local for local API development or set these in Vercel.
# Never commit real values or expose server-only variables with a VITE_ prefix.
MONGODB_URI=
MONGODB_DATABASE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
OWNER_EMAIL=
# EmailJS account keys are server-side; never prefix these with VITE_.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional EmailJS private key for authenticated server-side REST requests.
EMAILJS_PRIVATE_KEY=
# Optional public site origin used by EmailJS domain allowlisting (e.g. https://example.com).
EMAILJS_SOURCE_ORIGIN=
# Cloudinary signed server-side uploads for quote attachments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
# Used only for the optional newsletter contact list.
RESEND_AUDIENCE_ID=
VITE_SITE_URL=
VITE_GA4_ID=
VITE_WHATSAPP_NUMBER=
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=
